zl:Internal-SessionEnded a zl:InternalEvent ; zl:internalName "session_ended" ; zl:foldsToWire "session.closed" .
zl:Internal-TurnStarted a zl:InternalEvent ; zl:internalName "turn_started" ; zl:foldsToWire "turn.started" .
zl:Internal-TurnInputReceived a zl:InternalEvent ; zl:internalName "turn_input_received" ; zl:foldsToWire "session.updated" .
