zl:EventType-userInput-resolved a pi:EventType ; pi:typeId "user_input_resolved" .
zl:EventType-checkpoint-created a pi:EventType ; pi:typeId "checkpoint_created" .
zl:EventType-rewind-triggered a pi:EventType ; pi:typeId "rewind_triggered" .
zl:EventType-streamRecovery-updated a pi:EventType ; pi:typeId "stream_recovery_updated" .
zl:EventType-result a pi:EventType ; pi:typeId "result" .

# ===== e2o relations (path into the raw record) =====
zl:Rel-Stream-session a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-session ; pi:hasQualifier zl:Qualifier-in_session ; pi:objectIdPath "sessionId" .
zl:Rel-Stream-turn a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-turn ; pi:hasQualifier zl:Qualifier-in_turn ; pi:objectIdPath "turnId" .
zl:Rel-Stream-tool_call a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-tool_call ; pi:hasQualifier zl:Qualifier-about_tool_call ; pi:objectIdPath "payload.toolCallId" .
zl:Rel-Stream-model_request a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-model_request ; pi:hasQualifier zl:Qualifier-about_model_request ; pi:objectIdPath "payload.requestId" .
zl:Rel-Stream-subagent a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-subagent ; pi:hasQualifier zl:Qualifier-by_subagent ; pi:objectIdPath "payload.agentId" .
zl:Rel-Stream-permission a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-permission ; pi:hasQualifier zl:Qualifier-about_permission ; pi:objectIdPath "payload.requestId" .
zl:Rel-App-session a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-session ; pi:hasQualifier zl:Qualifier-in_session ; pi:objectIdPath "params.sessionId" .
zl:Rel-App-turn a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-turn ; pi:hasQualifier zl:Qualifier-in_turn ; pi:objectIdPath "params.turnId" .
zl:Rel-App-tool_call a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-tool_call ; pi:hasQualifier zl:Qualifier-about_tool_call ; pi:objectIdPath "params.payload.toolCallId" .
zl:Rel-App-model_request a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-model_request ; pi:hasQualifier zl:Qualifier-about_model_request ; pi:objectIdPath "params.payload.requestId" .
zl:Rel-App-subagent a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-subagent ; pi:hasQualifier zl:Qualifier-by_subagent ; pi:objectIdPath "params.payload.agentId" .
zl:Rel-App-permission a pi:E2ORelation ; pi:relatesObjectType zl:ObjectType-permission ; pi:hasQualifier zl:Qualifier-about_permission ; pi:objectIdPath "params.payload.requestId" .

