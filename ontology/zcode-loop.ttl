# ===== loop states: turn machine. Transition names equal OCEL event type ids, so replay folds the log. =====
zl:TurnMachine a st:Machine ; st:machineName "ZcodeTurn" ; st:initial zl:TurnIdle .
zl:TurnIdle a st:State ; st:inMachine zl:TurnMachine ; st:stateName "Idle" ; st:seq 0 .
zl:TurnRunning a st:State ; st:inMachine zl:TurnMachine ; st:stateName "Running" ; st:seq 1 .
zl:TurnCompleted a st:State ; st:inMachine zl:TurnMachine ; st:stateName "Completed" ; st:seq 2 .
zl:TurnFailed a st:State ; st:inMachine zl:TurnMachine ; st:stateName "Failed" ; st:seq 3 .
zl:TurnStart a st:Transition ; st:transitionName "turn_started" ; st:kind "advance" ; st:from zl:TurnIdle ; st:to zl:TurnRunning .
zl:TurnComplete a st:Transition ; st:transitionName "turn_completed" ; st:kind "advance" ; st:from zl:TurnRunning ; st:to zl:TurnCompleted .
zl:TurnFail a st:Transition ; st:transitionName "turn_failed" ; st:kind "abort" ; st:from zl:TurnRunning ; st:to zl:TurnFailed .
zl:TurnStartAgain a st:Transition ; st:transitionName "turn_started" ; st:kind "loop" ; st:from zl:TurnCompleted ; st:to zl:TurnRunning .
zl:TurnRetry a st:Transition ; st:transitionName "turn_started" ; st:kind "retry" ; st:from zl:TurnFailed ; st:to zl:TurnRunning .

# ===== receipt / event-record shapes (shacl-projection-pack -> zod + JSON Schema) =====
ex:ReceiptEntryShape a sh:NodeShape ;
  sh:property [ sh:path ex:entry_id ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:parent_hash ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:phase ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:standing ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:subject ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:action ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:pending_ref ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:hash ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] .
zl:ReceiptEntry a sp:SchemaModel ; sp:className "ReceiptEntry" ; sp:derivedFromShape ex:ReceiptEntryShape .
ex:OcelEventShape a sh:NodeShape ;
  sh:property [ sh:path ex:id ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:type ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
    [ sh:path ex:time ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] .
zl:OcelEventRecord a sp:SchemaModel ; sp:className "OcelEventRecord" ; sp:derivedFromShape ex:OcelEventShape .
