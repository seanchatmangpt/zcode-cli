# ===== internal enum W -> wire projection (documentation of what each wire event folds) =====
zl:InternalEvent a rdfs:Class .
zl:Internal-SessionCreated a zl:InternalEvent ; zl:internalName "session_created" ; zl:foldsToWire "session.created" .
