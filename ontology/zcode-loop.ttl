zl:Internal-TurnError a zl:InternalEvent ; zl:internalName "turn_error" ; zl:foldsToWire "turn.failed" .
zl:Internal-UserMessage a zl:InternalEvent ; zl:internalName "user_message" ; zl:foldsToWire "message.upserted" .
zl:Internal-AssistantMessage a zl:InternalEvent ; zl:internalName "assistant_message" ; zl:foldsToWire "message.upserted" .
