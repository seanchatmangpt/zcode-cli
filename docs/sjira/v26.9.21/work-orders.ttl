sj:acc-zocel-004-1 a sj:AcceptanceCriterion ;
    rdfs:label "Marketplace validates" ;
    dcterms:description "cd /Users/sac/ggen-marketplace && python3 scripts/marketplace.py validate; echo rc=$?. Expected: rc=0 and output contains 'packs=319'. Earns: MARKETPLACE_VALID." .
sj:acc-zocel-004-2 a sj:AcceptanceCriterion ;
    rdfs:label "Qualify failing set matches baseline" ;
    dcterms:description "Run: mkdir -p /Users/sac/wt/zocel-runs && cd /Users/sac/ggen-marketplace && python3 scripts/qualify_packs.py > /Users/sac/wt/zocel-runs/qualify.log 2>&1; grep -i fail /Users/sac/wt/zocel-runs/qualify.log | sort -u > /Users/sac/wt/zocel-runs/qualify-fail.txt; sort -u /Users/sac/wt/mp-baseline-failures.txt > /Users/sac/wt/zocel-runs/baseline-sorted.txt; diff /Users/sac/wt/zocel-runs/qualify-fail.txt /Users/sac/wt/zocel-runs/baseline-sorted.txt; echo rc=$?. Expected: rc=0 (identical to the 24-entry baseline). Any difference => FAIL. Earns: BASELINE_MATCH." .
sj:acc-zocel-004-3 a sj:AcceptanceCriterion ;
    rdfs:label "Event-sourcing chains ALIVE" ;
    dcterms:description "cd /Users/sac/ggen-marketplace && python3 scripts/es_chain_qualify.py; echo rc=$?. Expected: rc=0 and every pack line reads ALIVE, none other. Earns: ES_CHAIN_ALIVE." .
sj:acc-zocel-004-4 a sj:AcceptanceCriterion ;
    rdfs:label "Pack tests pass" ;
    dcterms:description "cd /Users/sac/ggen-marketplace && python3 -m pytest -q $(ls packs/*/test*.py packs/*/tests/*.py 2>/dev/null) for the merged packs; echo rc=$?. Expected: rc=0, 0 failed. Earns: PACK_TESTS_PASS." .
sj:acc-zocel-004-5 a sj:AcceptanceCriterion ;
    rdfs:label "Targets sidecar present" ;
    dcterms:description "for f in /Users/sac/ggen-marketplace/packs/*/targets.toml; do test -s \"$f\" || echo EMPTY $f; done; echo rc=$?. Expected: no EMPTY lines and rc=0, so every targets.toml sidecar is nonempty. Earns: SIDECAR_PRESENT." .
sj:acc-zocel-004-6 a sj:AcceptanceCriterion ;
    rdfs:label "Signing-key decision recorded" ;
    dcterms:description "The ZOCEL-004 receipt contains the literal line 'signing-keys: BLOCKED-on-human' and cd /Users/sac/ggen-marketplace && git diff --stat -- '*.key' '*.pem' '*.sk' prints nothing (exit 0, no key touched). Earns: BLOCKED (human decision), never ALIVE." .

sj:fal-zocel-004-1 a sj:Falsifier ;
    rdfs:label "Baseline drift" ;
    dcterms:description "A failing set that differs from the 24-entry baseline in either direction falsifies the match." .
sj:fal-zocel-004-2 a sj:Falsifier ;
    rdfs:label "Pack count drift" ;
    dcterms:description "packs not equal to 319 falsifies the validate claim." .

