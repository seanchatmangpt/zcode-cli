    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:run-court-zocel-002 ;
    sj:nextCheckpoint sj:cp-zocel-002 .

sj:court-zocel-002 a sj:Court ;
    rdfs:label "ZOCEL-002 exact-subject court" ;
    dcterms:description "Independent court for Per-language pending/outcome parity with shared golden vectors: runs the acceptance commands at an exact head in the worktree scope and binds candidateSha, subjectSha, tool versions and receipt identity." .

sj:acc-zocel-002-1 a sj:AcceptanceCriterion ;
    rdfs:label "Golden vectors exist" ;
    dcterms:description "Files created by this work order; absent => NOT_RUN. cd /Users/sac/dev/zcode-cli && test -s test/fixtures/ocel-golden-chain.json exits 0, and grep -l ocel-golden-chain.json test/ocel-*.test.ts /Users/sac/wt/zocel-runs/py/*.py lists both a TypeScript and a Python reader of that one path. Missing file or single reader => FAIL. Earns: SHARED_VECTOR." .
sj:acc-zocel-002-2 a sj:AcceptanceCriterion ;
    rdfs:label "TypeScript parity" ;
    dcterms:description "cd /Users/sac/dev/zcode-cli && bun test test/ocel-generated.test.ts test/ocel-conformance.test.ts exits 0 with 0 fail, each golden vector digest asserted equal to the literal in test/fixtures/ocel-golden-chain.json. Earns: TS_PARITY." .
sj:acc-zocel-002-3 a sj:AcceptanceCriterion ;
    rdfs:label "Python parity" ;
    dcterms:description "cd /Users/sac/dev/zcode-cli && python3 -m pytest -q test/py 2>&1 | tail -3 exits 0 with '0 failed' (test/py is created by this work order; absent => NOT_RUN), and for every vector id in test/fixtures/ocel-golden-chain.json the Python digest string equals the TypeScript digest string (diff of the two digest lists exits 0). Earns: PY_PARITY." .

sj:fal-zocel-002-1 a sj:Falsifier ;
    rdfs:label "Divergent digest" ;
    dcterms:description "Any golden vector whose TypeScript and Python chain digests differ falsifies parity." .
sj:fal-zocel-002-2 a sj:Falsifier ;
    rdfs:label "Private vectors" ;
    dcterms:description "A vector duplicated per language rather than shared falsifies the shared-vector requirement." .

sj:edge-zocel-002-on-001 a sj:DependencyEdge ;
    rdfs:label "ZOCEL-002 depends on ZOCEL-001" ;
    dcterms:description "ZOCEL-002 requires ZOCEL-001 at standing ALIVE before it may start; standing is not inherited." ;
    sj:dependencyType "requiresVerifier" ;
    sj:upstreamWorkOrder sj:zocel-001 ;
    sj:requiredStanding "ALIVE" .

sj:cp-zocel-002 a sj:Checkpoint ;
    rdfs:label "ZOCEL-002 checkpoint" ;
    dcterms:description "Closed when the ZOCEL-002 court returns a receipt at the exact head; the frontier then advances to dependents of this work order." .

