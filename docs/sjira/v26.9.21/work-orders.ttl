sj:acc-zocel-007-1 a sj:AcceptanceCriterion ;
    rdfs:label "No new test failures" ;
    dcterms:description "mkdir -p /Users/sac/wt/zocel-runs && cd /Users/sac/dev/zcode-cli && bun test 2>&1 | grep -E '^\\(fail\\)' | sort -u > /Users/sac/wt/zocel-runs/fail-now.txt; comm -23 /Users/sac/wt/zocel-runs/fail-now.txt /Users/sac/wt/zocel-runs/main-fail-baseline.txt (baseline recorded from main 5e20ab3 under ZOCEL-013). Expected: prints nothing, meaning no failure absent from the baseline. Missing baseline file => NOT_RUN. Earns: NO_NEW_FAILURES." .
sj:acc-zocel-007-2 a sj:AcceptanceCriterion ;
    rdfs:label "Sync gates green" ;
    dcterms:description "cd /Users/sac/dev/zcode-cli && bun run sync:locked; echo rc=$? and bun scripts/sync-runtime.ts --check --lock zcode-runtime.lock.json; echo rc=$?. Expected: both rc=0. Earns: SYNC_GREEN." .
sj:acc-zocel-007-3 a sj:AcceptanceCriterion ;
    rdfs:label "No anchor drift" ;
    dcterms:description "cd /Users/sac/dev/zcode-cli && bun test test/sync-runtime-anchor-drift.test.ts test/sync-runtime-loop-gaps.test.ts; echo rc=$?. Expected: rc=0, 0 fail. The test/runtime directory holds the launcher and provider tests, not the patch-anchor tests. Earns: ANCHORS_HOLD." .
sj:acc-zocel-007-4 a sj:AcceptanceCriterion ;
    rdfs:label "maxTurns stops a live loop" ;
    dcterms:description "mkdir -p /Users/sac/wt/zocel-runs && cd /Users/sac/dev/zcode-cli && node bin/zcode.js --help | grep -c max-turns prints 0 (no CLI flag), so drive 'node bin/zcode.js app-server' over stdio with a turn config maxTurns of 2 and a prompt that needs a tool call each turn, capturing stream output to /Users/sac/wt/zocel-runs/maxturns.jsonl. Expected: grep -c error_max_turns /Users/sac/wt/zocel-runs/maxturns.jsonl prints 1 or more. No capture => NOT_RUN. Earns: OBSERVED_LIVE_STOP." .
sj:acc-zocel-007-5 a sj:AcceptanceCriterion ;
    rdfs:label "Ledger events in stream" ;
    dcterms:description "grep -ci ledger /Users/sac/wt/zocel-runs/maxturns.jsonl prints a count above 0 (same run as acc-zocel-007-4); count 0 or missing file => FAIL/NOT_RUN. Earns: LEDGER_OBSERVED." .

sj:fal-zocel-007-1 a sj:Falsifier ;
    rdfs:label "Unit-only proof" ;
    dcterms:description "A maxTurns claim supported only by unit tests falsifies the live-loop requirement." .
sj:fal-zocel-007-2 a sj:Falsifier ;
    rdfs:label "Silent baseline growth" ;
    dcterms:description "A new failing test not in the baseline falsifies no-new-failures." .

