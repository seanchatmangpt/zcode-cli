sj:acc-zocel-011-1 a sj:AcceptanceCriterion ;
    rdfs:label "Adapter ALIVE by observation" ;
    dcterms:description "The adapter is recorded ALIVE only with a real run log whose chain verifies, by the ZOCEL-001 verifier command exit 0." .
sj:acc-zocel-011-2 a sj:AcceptanceCriterion ;
    rdfs:label "Second consumer" ;
    dcterms:description "An OCEL log from the xaas Ultracode loop graph validates against the same OCEL 2.0 schema." .
sj:acc-zocel-011-3 a sj:AcceptanceCriterion ;
    rdfs:label "Loop comparison query" ;
    dcterms:description "queries/compare-loops.rq executes with a real SPARQL engine exit 0 over both consumers' logs and returns at least one row." .
sj:acc-zocel-011-4 a sj:AcceptanceCriterion ;
    rdfs:label "Python reuse proof" ;
    dcterms:description "The Python consumer reuses the generated verifier and its test exits 0 against the shared golden vectors." .

