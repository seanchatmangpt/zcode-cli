# ---- ZOCEL-001 ----
sj:zocel-001
    a sj:WorkOrder ;
    rdfs:label "ZOCEL-001: Land the OCEL consumer branch with a real observed run" ;
    dcterms:identifier "ZOCEL-001" ;
    dcterms:title "Land the OCEL consumer branch with a real observed run" ;
    dcterms:description "Land feat/zcode-ocel-consumer so the zcode agent loop emits a sealed OCEL 2.0 log and receipt from a real session, verified by the generated verifier and replayed through the generated transition table. A run with no log is NOT_RUN per the gymact ocel-standing rule." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "1aceb47e935200c6f67960fa2b6125d1a24fae85" ;
    sj:subject "zcode-cli:feat/zcode-ocel-consumer" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "IMPLEMENTED_UNVERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt binding candidateSha, subjectSha and a durable receipt for this subject; a passing test log alone, a generated ticket, or an upstream standing is not promotion." ;
    sj:replayIdentity "semantic-jira:v26.9.21:ZOCEL-001" ;
    sj:pathScope "src", "scripts", "test", "ontology" ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:requiresCourt sj:court-zocel-001 ;
    sj:requiresEvidence sj:source-evidence, sj:local-execution-evidence, sj:runtime-evidence, sj:process-evidence, sj:receipt-evidence, sj:replay-evidence ;
    sj:acceptance sj:acc-zocel-001-1, sj:acc-zocel-001-2, sj:acc-zocel-001-3, sj:acc-zocel-001-4, sj:acc-zocel-001-5, sj:acc-zocel-001-6 ;
    sj:falsifier sj:fal-zocel-001-1, sj:fal-zocel-001-2, sj:fal-zocel-001-3 ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:run-court-zocel-001 ;
    sj:nextCheckpoint sj:cp-zocel-001 .

sj:court-zocel-001 a sj:Court ;
    rdfs:label "ZOCEL-001 exact-subject court" ;
    dcterms:description "Independent court for Land the OCEL consumer branch with a real observed run: runs the acceptance commands at an exact head in the worktree scope and binds candidateSha, subjectSha, tool versions and receipt identity." .

sj:acc-zocel-001-1 a sj:AcceptanceCriterion ;
    rdfs:label "Static gates pass" ;
    dcterms:description "In /Users/sac/wt/zcode-ocel-consumer, 'bun run typecheck' exits 0, 'bun test test/ocel-*.test.ts' reports 0 fail, and 'bun scripts/gen-ocel.ts --check' prints no STALE line and exits 0." .
sj:acc-zocel-001-2 a sj:AcceptanceCriterion ;
    rdfs:label "Real run emits log and receipt" ;
    dcterms:description "'ZCODE_OCEL=1 zcode -p <prompt> --output-format stream-json' exits 0 and produces <session>.jsonocel and <session>.receipt.json on disk; absence of either is NOT_RUN, never ALIVE." .
sj:acc-zocel-001-3 a sj:AcceptanceCriterion ;
    rdfs:label "Log validates against OCEL 2.0 schema" ;
    dcterms:description "The produced .jsonocel validates against an OCEL 2.0 jsonschema with zero errors." .
sj:acc-zocel-001-4 a sj:AcceptanceCriterion ;
    rdfs:label "Receipt chain verifies" ;
    dcterms:description "The generated verifier chain-verifies the receipt over the real log and exits 0." .
sj:acc-zocel-001-5 a sj:AcceptanceCriterion ;
    rdfs:label "Replay is conformant" ;
    dcterms:description "Replaying the real log through the generated st: transition table yields zero non-conformant transitions." .
sj:acc-zocel-001-6 a sj:AcceptanceCriterion ;
    rdfs:label "Seal-twice refused and tamper detected" ;
    dcterms:description "Sealing the same session a second time is refused with a typed error, and flipping one byte of the log makes chain verification fail." .

sj:fal-zocel-001-1 a sj:Falsifier ;
    rdfs:label "Fixture-only evidence" ;
    dcterms:description "A passing test suite with no real .jsonocel from a live zcode run falsifies ALIVE; standing stays NOT_RUN." .
sj:fal-zocel-001-2 a sj:Falsifier ;
    rdfs:label "Stale generated code" ;
    dcterms:description "'gen-ocel.ts --check' reporting STALE falsifies the claim that generated verifier and table match the ontology." .
sj:fal-zocel-001-3 a sj:Falsifier ;
    rdfs:label "Tamper undetected" ;
    dcterms:description "A mutated log that still chain-verifies falsifies tamper detection." .

sj:cp-zocel-001 a sj:Checkpoint ;
    rdfs:label "ZOCEL-001 checkpoint" ;
    dcterms:description "Closed when the ZOCEL-001 court returns a receipt at the exact head; the frontier then advances to dependents of this work order." .

# ---- ZOCEL-002 ----
sj:zocel-002
    a sj:WorkOrder ;
    rdfs:label "ZOCEL-002: Per-language pending/outcome parity with shared golden vectors" ;
    dcterms:identifier "ZOCEL-002" ;
    dcterms:title "Per-language pending/outcome parity with shared golden vectors" ;
    dcterms:description "Prove the TypeScript and Python OCEL implementations agree on pending and outcome event handling by driving both from one shared set of golden chain vectors stored in the consumer." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "1aceb47e935200c6f67960fa2b6125d1a24fae85" ;
    sj:subject "zcode-cli:ocel-ts-py-parity" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "IMPLEMENTED_UNVERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt binding candidateSha, subjectSha and a durable receipt for this subject; a passing test log alone, a generated ticket, or an upstream standing is not promotion." ;
    sj:replayIdentity "semantic-jira:v26.9.21:ZOCEL-002" ;
    sj:pathScope "test", "scripts" ;
    sj:requiresReceiptClass "verification" ;
    sj:dependsOn sj:edge-zocel-002-on-001 ;
    sj:requiresCourt sj:court-zocel-002 ;
