    rdfs:label "Adapter claimed without run" ;
    dcterms:description "An ALIVE mark with no real run log falsifies the adapter claim." .
sj:fal-zocel-011-2 a sj:Falsifier ;
    rdfs:label "Empty comparison" ;
    dcterms:description "A compare-loops query returning zero rows falsifies comparability." .

