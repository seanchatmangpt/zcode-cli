# ---- ZOCEL-011 ----
sj:zocel-011
    a sj:WorkOrder ;
    rdfs:label "ZOCEL-011: Retire unverified follow-ups" ;
    dcterms:identifier "ZOCEL-011" ;
    dcterms:title "Retire unverified follow-ups" ;
    dcterms:description "Resolve the UNVERIFIED follow-ups: mark the adapter ALIVE only after an observed real run, add a second real consumer over the xaas Ultracode loop graph with a comparison query, and prove Python reuse." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "5e20ab3c9dff97edd35deee6759c5e5961ee1a05" ;
    sj:subject "zcode-cli:ocel-followups" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt binding candidateSha, subjectSha and a durable receipt for this subject; a passing test log alone, a generated ticket, or an upstream standing is not promotion." ;
    sj:replayIdentity "semantic-jira:v26.9.21:ZOCEL-011" ;
    sj:pathScope "ontology", "queries", "scripts", "test" ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:dependsOn sj:edge-zocel-011-on-001, sj:edge-zocel-011-on-005 ;
    sj:requiresCourt sj:court-zocel-011 ;
    sj:requiresEvidence sj:source-evidence, sj:runtime-evidence, sj:process-evidence, sj:receipt-evidence ;
    sj:acceptance sj:acc-zocel-011-1, sj:acc-zocel-011-2, sj:acc-zocel-011-3, sj:acc-zocel-011-4 ;
    sj:falsifier sj:fal-zocel-011-1, sj:fal-zocel-011-2 ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:run-court-zocel-011 ;
    sj:nextCheckpoint sj:cp-zocel-011 .

sj:court-zocel-011 a sj:Court ;
    rdfs:label "ZOCEL-011 exact-subject court" ;
    dcterms:description "Independent court for Retire unverified follow-ups: runs the acceptance commands at an exact head in the worktree scope and binds candidateSha, subjectSha, tool versions and receipt identity." .

sj:acc-zocel-011-1 a sj:AcceptanceCriterion ;
    rdfs:label "Adapter ALIVE by observation" ;
    dcterms:description "Run: mkdir -p /Users/sac/wt/zocel-runs && LOG=$(ls -t /Users/sac/wt/zocel-runs/001/*.jsonocel | head -1) && cd /Users/sac/dev/zcode-cli && the ZOCEL-001 verifier command (acc-zocel-001-4) over \"$LOG\" exits 0; adapter standing is ALIVE only if that exit is 0, otherwise NOT_RUN. Earns: ADAPTER_ALIVE." .
sj:acc-zocel-011-2 a sj:AcceptanceCriterion ;
    rdfs:label "Second consumer" ;
    dcterms:description "python3 -c \"import json,jsonschema,sys; jsonschema.validate(json.load(open(sys.argv[1])), json.load(open('/Users/sac/gymact/src/gymact/schemas/ocel20-schema.json')))\" the xaas Ultracode loop-graph OCEL file (find /Users/sac/xaas -name '*.jsonocel' -o -name '*ocel*.json' | head -1); expected: exit 0, no output. No such file => BLOCKED. Earns: SECOND_CONSUMER_VALID." .
sj:acc-zocel-011-3 a sj:AcceptanceCriterion ;
    rdfs:label "Loop comparison query" ;
    dcterms:description "test -s /Users/sac/dev/zcode-cli/queries/compare-loops.rq || echo NOT_RUN (query authored by this work order; it does not exist on main or in pi-ocel-tap). cd /Users/sac/dev/zcode-cli && python3 -c \"import rdflib,sys;g=rdflib.Graph();[g.parse(f) for f in sys.argv[1:]];print(len(list(g.query(open('queries/compare-loops.rq').read()))))\" /Users/sac/wt/zocel-runs/zcode.ttl /Users/sac/wt/zocel-runs/ultracode.ttl (the two consumers' logs converted to RDF); expected: exit 0 and printed row count >= 1. Zero rows => FAIL. Earns: LOOPS_COMPARABLE." .
sj:acc-zocel-011-4 a sj:AcceptanceCriterion ;
    rdfs:label "Python reuse proof" ;
    dcterms:description "test -d /Users/sac/dev/zcode-cli/test/py || echo NOT_RUN (created under ZOCEL-002). cd /Users/sac/dev/zcode-cli && python3 -m pytest -q test/py 2>&1 | tail -2; expected exit 0 with '0 failed', using the shared golden vector test/fixtures/ocel-golden-chain.json. Earns: PY_REUSE." .

sj:fal-zocel-011-1 a sj:Falsifier ;
    rdfs:label "Adapter claimed without run" ;
    dcterms:description "An ALIVE mark with no real run log falsifies the adapter claim." .
sj:fal-zocel-011-2 a sj:Falsifier ;
    rdfs:label "Empty comparison" ;
    dcterms:description "A compare-loops query returning zero rows falsifies comparability." .

sj:edge-zocel-011-on-001 a sj:DependencyEdge ;
    rdfs:label "ZOCEL-011 depends on ZOCEL-001" ;
    dcterms:description "ZOCEL-011 requires ZOCEL-001 at standing ALIVE before it may start; standing is not inherited." ;
    sj:dependencyType "requiresRuntime" ;
    sj:upstreamWorkOrder sj:zocel-001 ;
    sj:requiredStanding "ALIVE" .

sj:edge-zocel-011-on-005 a sj:DependencyEdge ;
    rdfs:label "ZOCEL-011 depends on ZOCEL-005" ;
    dcterms:description "ZOCEL-011 requires ZOCEL-005 at standing ALIVE before it may start; standing is not inherited." ;
    sj:dependencyType "requiresObservation" ;
    sj:upstreamWorkOrder sj:zocel-005 ;
    sj:requiredStanding "ALIVE" .

sj:cp-zocel-011 a sj:Checkpoint ;
    rdfs:label "ZOCEL-011 checkpoint" ;
    dcterms:description "Closed when the ZOCEL-011 court returns a receipt at the exact head; the frontier then advances to dependents of this work order." .

# ---- ZOCEL-012 ----
sj:zocel-012
    a sj:WorkOrder ;
    rdfs:label "ZOCEL-012: Worktree hygiene triage" ;
    dcterms:identifier "ZOCEL-012" ;
    dcterms:title "Worktree hygiene triage" ;
    dcterms:description "Inventory stale worktrees under .claude/worktrees/wf_d1f79f3f-d17-* and /private/tmp/xaas-w*, and produce a keep-or-discard list for human decision. No worktree is removed by an agent." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "5e20ab3c9dff97edd35deee6759c5e5961ee1a05" ;
    sj:subject "zcode-cli:worktree-hygiene" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "OBSERVE" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt binding candidateSha, subjectSha and a durable receipt for this subject; a passing test log alone, a generated ticket, or an upstream standing is not promotion." ;
    sj:replayIdentity "semantic-jira:v26.9.21:ZOCEL-012" ;
    sj:pathScope ".claude/worktrees" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresCourt sj:court-zocel-012 ;
    sj:requiresEvidence sj:local-execution-evidence, sj:receipt-evidence ;
    sj:acceptance sj:acc-zocel-012-1, sj:acc-zocel-012-2, sj:acc-zocel-012-3 ;
    sj:falsifier sj:fal-zocel-012-1, sj:fal-zocel-012-2 ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:triage-worktrees ;
    sj:nextCheckpoint sj:cp-zocel-012 .

sj:court-zocel-012 a sj:Court ;
    rdfs:label "ZOCEL-012 exact-subject court" ;
    dcterms:description "Independent court for Worktree hygiene triage: runs the acceptance commands at an exact head in the worktree scope and binds candidateSha, subjectSha, tool versions and receipt identity." .

sj:acc-zocel-012-1 a sj:AcceptanceCriterion ;
    rdfs:label "Inventory complete" ;
    dcterms:description "Run: mkdir -p /Users/sac/wt/zocel-runs && for r in /Users/sac/dev/zcode-cli /Users/sac/ggen-marketplace /Users/sac/ggen_igniter; do git -C $r worktree list; done > /Users/sac/wt/zocel-runs/wt-list.txt; awk '{print $1}' /Users/sac/wt/zocel-runs/wt-list.txt | sort > /Users/sac/wt/zocel-runs/wt-paths.txt; awk '{print $1}' /Users/sac/wt/zocel-runs/triage.txt | sort > /Users/sac/wt/zocel-runs/triage-paths.txt; comm -23 /Users/sac/wt/zocel-runs/wt-paths.txt /Users/sac/wt/zocel-runs/triage-paths.txt prints nothing (every worktree path under /Users/sac/wt appears in the triage list, triage.txt written by the ZOCEL-012 triage step into the same directory). Earns: INVENTORY_COMPLETE." .
sj:acc-zocel-012-2 a sj:AcceptanceCriterion ;
    rdfs:label "Dirty state recorded" ;
    dcterms:description "For each path in the first column of /Users/sac/wt/zocel-runs/triage.txt (loop: for path in the awk-extracted first column): git -C \"$path\" status --porcelain and git -C \"$path\" rev-list --count origin/main..HEAD are recorded on that entry; a triage line without both fields => FAIL. Earns: DIRTY_STATE_RECORDED." .
sj:acc-zocel-012-3 a sj:AcceptanceCriterion ;
    rdfs:label "Decision is human" ;
    dcterms:description "Each triage line ends in keep|discard|undecided (grep -vcE '(keep|discard|undecided)$' triage.txt prints 0) and re-running the git worktree list command yields output identical to wt-list.txt (diff exit 0), so no deletion ran. Earns: HUMAN_DECISION_PRESERVED." .

sj:fal-zocel-012-1 a sj:Falsifier ;
    rdfs:label "Unlisted worktree" ;
    dcterms:description "A matching worktree absent from the list falsifies completeness." .
sj:fal-zocel-012-2 a sj:Falsifier ;
    rdfs:label "Agent deletion" ;
    dcterms:description "Any worktree removed by an agent falsifies the human-decision boundary." .

sj:cp-zocel-012 a sj:Checkpoint ;
    rdfs:label "ZOCEL-012 checkpoint" ;
    dcterms:description "Closed when the ZOCEL-012 court returns a receipt at the exact head; the frontier then advances to dependents of this work order." .

# ---- ZOCEL-013 ----
sj:zocel-013
    a sj:WorkOrder ;
    rdfs:label "ZOCEL-013: Quarantine or fix the pre-existing failing tests so release:build can pass" ;
    dcterms:identifier "ZOCEL-013" ;
    dcterms:title "Quarantine or fix the pre-existing failing tests so release:build can pass" ;
    dcterms:description "Main has about 10 pre-existing failing tests (subagent-builtin-provider override, launcher keyless prompt, execution-state-tui x2, prompt-preflight x3, model-catalog-tui registry reload, TUI notifications x2), so test:all and therefore release:build exit 1. Fix them, or record a human-approved baseline-exclusion list." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "5e20ab3c9dff97edd35deee6759c5e5961ee1a05" ;
    sj:subject "zcode-cli:main-baseline-failures" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt binding candidateSha, subjectSha and a durable receipt for this subject; a passing test log alone, a generated ticket, or an upstream standing is not promotion." ;
    sj:replayIdentity "semantic-jira:v26.9.21:ZOCEL-013" ;
    sj:pathScope "test", "src", "scripts" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresCourt sj:court-zocel-013 ;
    sj:requiresEvidence sj:source-evidence, sj:local-execution-evidence, sj:receipt-evidence ;
    sj:acceptance sj:acc-zocel-013-1, sj:acc-zocel-013-2 ;
    sj:falsifier sj:fal-zocel-013-1, sj:fal-zocel-013-2 ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:run-court-zocel-013 ;
    sj:nextCheckpoint sj:cp-zocel-013 .

sj:court-zocel-013 a sj:Court ;
    rdfs:label "ZOCEL-013 exact-subject court" ;
    dcterms:description "Independent court for Quarantine or fix the pre-existing failing tests so release:build can pass: runs the acceptance commands at an exact head in the worktree scope and binds candidateSha, subjectSha, tool versions and receipt identity." .

sj:acc-zocel-013-1 a sj:AcceptanceCriterion ;
    rdfs:label "Release build passes or baseline approved" ;
    dcterms:description "cd /Users/sac/dev/zcode-cli && bun run release:build; echo rc=$?. Expected: rc=0, OR a recorded human-approved baseline-exclusion list at /Users/sac/wt/zocel-runs/main-fail-baseline.txt whose last line starts approved-by: naming the human (grep -c '^approved-by:' prints 1). Neither => FAIL. Earns: RELEASE_BUILD_PASS or BASELINE_APPROVED." .
sj:acc-zocel-013-2 a sj:AcceptanceCriterion ;
    rdfs:label "Failures subset of baseline" ;
    dcterms:description "mkdir -p /Users/sac/wt/zocel-runs && cd /Users/sac/dev/zcode-cli && bun test 2>&1 | grep -E '^\\(fail\\)' | sort -u > /Users/sac/wt/zocel-runs/now-fail.txt; comm -23 /Users/sac/wt/zocel-runs/now-fail.txt /Users/sac/wt/zocel-runs/main-fail-baseline.txt. Expected: prints nothing (every failure is listed in the baseline). Earns: SUBSET_OF_BASELINE." .

sj:fal-zocel-013-1 a sj:Falsifier ;
    rdfs:label "Failure absent from baseline" ;
    dcterms:description "Any failing test in the run that is absent from the baseline list falsifies the subset claim." .
sj:fal-zocel-013-2 a sj:Falsifier ;
    rdfs:label "Unapproved exclusion" ;
    dcterms:description "A baseline-exclusion list without a human approved-by line falsifies the baseline route." .

sj:cp-zocel-013 a sj:Checkpoint ;
    rdfs:label "ZOCEL-013 checkpoint" ;
    dcterms:description "Closed when the ZOCEL-013 court returns a receipt at the exact head; the frontier then advances to dependents of this work order." .

