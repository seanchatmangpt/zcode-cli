# ---- ZOCEL-001 ----
sj:zocel-001
    a sj:WorkOrder ;
    rdfs:label "ZOCEL-001: Land the OCEL consumer branch with a real observed run" ;
    dcterms:identifier "ZOCEL-001" ;
    dcterms:title "Land the OCEL consumer branch with a real observed run" ;
    dcterms:description "Verification remainder for feat/zcode-ocel-consumer, merged into local main (5e20ab3, not pushed). Observed once: ZCODE_OCEL=1 with --output-format stream-json emitted a 13-event .jsonocel and .receipt.json with an intact verifyChain. Standing stays UNKNOWN until a court receipt exists. Remaining: repeatable exact-head court run, and the app-server source, which was not exercised. Without --output-format stream-json the tap emits nothing." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "5e20ab3c9dff97edd35deee6759c5e5961ee1a05" ;
    sj:subject "zcode-cli:feat/zcode-ocel-consumer" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "IMPLEMENTED_UNVERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt binding candidateSha, subjectSha and a durable receipt for this subject; a passing test log alone, a generated ticket, or an upstream standing is not promotion." ;
    sj:replayIdentity "semantic-jira:v26.9.21:ZOCEL-001" ;
    sj:pathScope "src", "scripts", "test", "ontology" ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:requiresCourt sj:court-zocel-001 ;
    sj:requiresEvidence sj:source-evidence, sj:local-execution-evidence, sj:runtime-evidence, sj:process-evidence, sj:receipt-evidence, sj:replay-evidence ;
    sj:acceptance sj:acc-zocel-001-1, sj:acc-zocel-001-2, sj:acc-zocel-001-3, sj:acc-zocel-001-4, sj:acc-zocel-001-5, sj:acc-zocel-001-6 ;
    sj:falsifier sj:fal-zocel-001-1, sj:fal-zocel-001-2, sj:fal-zocel-001-3 ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:run-court-zocel-001 ;
    sj:nextCheckpoint sj:cp-zocel-001 .

sj:court-zocel-001 a sj:Court ;
    rdfs:label "ZOCEL-001 exact-subject court" ;
    dcterms:description "Independent court for Land the OCEL consumer branch with a real observed run: runs the acceptance commands at an exact head in the worktree scope and binds candidateSha, subjectSha, tool versions and receipt identity." .

sj:acc-zocel-001-1 a sj:AcceptanceCriterion ;
    rdfs:label "Static gates pass" ;
    dcterms:description "cd /Users/sac/dev/zcode-cli (main) && git rev-parse HEAD equals the pinned baseSha, then 'bun run typecheck' exits 0, 'bun test test/ocel-*.test.ts' reports 0 fail, and 'bun scripts/gen-ocel.ts --check' prints no STALE line and exits 0." .
sj:acc-zocel-001-2 a sj:AcceptanceCriterion ;
    rdfs:label "Real run emits log and receipt" ;
    dcterms:description "Run: mkdir -p /Users/sac/wt/zocel-runs && touch /Users/sac/wt/zocel-runs/.mark && cd /Users/sac/dev/zcode-cli && ZCODE_OCEL=1 ZCODE_OCEL_DIR=/Users/sac/wt/zocel-runs/001 node bin/zcode.js -p 'Reply with exactly: PONG' --output-format stream-json. Expected: exit 0 and one *.jsonocel plus a sibling *.receipt.json found by: LOG=$(find /Users/sac/wt/zocel-runs/001 -name '*.jsonocel' -newer /Users/sac/wt/zocel-runs/.mark | head -1); test -s \"$LOG\" && test -s \"${LOG%.jsonocel}.receipt.json\" exits 0. No log or no receipt => standing NOT_RUN, never ALIVE. Earns: OBSERVED (real-run evidence) for the stream-json emit claim." .
sj:acc-zocel-001-3 a sj:AcceptanceCriterion ;
    rdfs:label "Log validates against OCEL 2.0 schema" ;
    dcterms:description "Run: mkdir -p /Users/sac/wt/zocel-runs && LOG=$(ls -t /Users/sac/wt/zocel-runs/001/*.jsonocel | head -1) && python3 -c \"import json,jsonschema,sys; jsonschema.validate(json.load(open(sys.argv[1])), json.load(open('/Users/sac/gymact/src/gymact/schemas/ocel20-schema.json')))\" \"$LOG\" exits 0 and prints nothing (zero validation errors). No LOG (acc-zocel-001-2 not yet run) => NOT_RUN. Earns: SCHEMA_VALID for the log; ALIVE only with acc-zocel-001-4..6." .
sj:acc-zocel-001-4 a sj:AcceptanceCriterion ;
    rdfs:label "Receipt chain verifies" ;
    dcterms:description "Run: mkdir -p /Users/sac/wt/zocel-runs && LOG=$(ls -t /Users/sac/wt/zocel-runs/001/*.jsonocel | head -1) && cd /Users/sac/dev/zcode-cli && bun scripts/gen-ocel.ts --check exits 0, then the generated verifier under src/ (path printed by gen-ocel.ts) run over \"$LOG\" and \"${LOG%.jsonocel}.receipt.json\" exits 0 and prints a chain-verified line. Nonzero exit or no LOG => NOT_RUN/FAIL. Earns: CHAIN_VERIFIED." .
sj:acc-zocel-001-5 a sj:AcceptanceCriterion ;
    rdfs:label "App-server tap capture" ;
    dcterms:description "App-server source capture, not yet exercised: mkdir -p /Users/sac/wt/zocel-runs/001-app && cd /Users/sac/dev/zcode-cli && drive 'ZCODE_OCEL=1 ZCODE_OCEL_DIR=/Users/sac/wt/zocel-runs/001-app node bin/zcode.js app-server' over stdio with one real prompt turn, then find /Users/sac/wt/zocel-runs/001-app -name '*.jsonocel' lists one file with a sibling *.receipt.json that verifyChain accepts. No file => NOT_RUN. Earns: APP_SERVER_TAP_OBSERVED." .
sj:acc-zocel-001-6 a sj:AcceptanceCriterion ;
    rdfs:label "Seal-twice refused and tamper detected" ;
    dcterms:description "Run: mkdir -p /Users/sac/wt/zocel-runs && LOG=$(ls -t /Users/sac/wt/zocel-runs/001/*.jsonocel | head -1) && cd /Users/sac/dev/zcode-cli && bun test test/ocel-generated.test.ts exits 0 with 0 fail, covering: a second seal of the same session returns a typed error (not exit 0 silently), and cp \"$LOG\" /Users/sac/wt/zocel-runs/tamper.jsonocel then printf '\\\\x00' | dd of=/Users/sac/wt/zocel-runs/tamper.jsonocel bs=1 seek=10 conv=notrunc flips one byte and the verifier over tamper.jsonocel exits nonzero. Earns: TAMPER_EVIDENT." .

sj:fal-zocel-001-1 a sj:Falsifier ;
    rdfs:label "Fixture-only evidence" ;
    dcterms:description "Observation: a green bun test with 'find ~/.zcode /Users/sac/wt/zocel-runs -name *.jsonocel -newer /Users/sac/wt/zocel-runs/.mark' returning no file refutes ALIVE; standing stays NOT_RUN." .
sj:fal-zocel-001-2 a sj:Falsifier ;
    rdfs:label "Stale generated code" ;
    dcterms:description "Observation: 'bun scripts/gen-ocel.ts --check' in /Users/sac/wt/zcode-ocel-consumer printing a line containing STALE refutes the claim that the generated verifier and table match ontology/zcode-loop.ttl." .
sj:fal-zocel-001-3 a sj:Falsifier ;
    rdfs:label "Tamper undetected" ;
    dcterms:description "Observation: the verifier exiting 0 on a copy of the log with one byte flipped (dd conv=notrunc) refutes tamper detection." .

sj:cp-zocel-001 a sj:Checkpoint ;
    rdfs:label "ZOCEL-001 checkpoint" ;
    dcterms:description "Closed when the ZOCEL-001 court returns a receipt at the exact head; the frontier then advances to dependents of this work order." .

