sj:run-court-zocel-011 a sj:Action ;
    rdfs:label "Next action for ZOCEL-011" ;
    dcterms:description "Run the acceptance commands of ZOCEL-011 at an exact head in the scoped worktree, preserve failure output as evidence, and never rerun an unchanged failure without a new hypothesis." .

sj:triage-worktrees a sj:Action ;
    rdfs:label "Next action for ZOCEL-012" ;
    dcterms:description "Observe only: list stale worktrees, record status and unmerged commits, and hand the keep-or-discard list to the human." .
