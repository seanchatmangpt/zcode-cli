@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical RDF for ZCODE work orders v26.11.21: post-integrity-wave dogfood
# + remaining Explore honesty/QMS + queued Exploit upgrades.
# Integrity PRs #21–#36+#38 are on main at baseSha 2580032 — do NOT re-open.
# Ticket IDs follow ZCODE-<YYMMDD>-NN (cf. ZCODE-26923-01). Edit this file, never a ticket.

sj:WorkOrder a rdfs:Class .
sj:Court a rdfs:Class .
sj:EvidenceRequirement a rdfs:Class .
sj:AcceptanceCriterion a rdfs:Class .
sj:Falsifier a rdfs:Class .
sj:Action a rdfs:Class .
sj:Checkpoint a rdfs:Class .
sj:ProjectionSpec a rdfs:Class .
sj:DependencyEdge a rdfs:Class .
sj:StrategicObjective a rdfs:Class .

sj:source-evidence a sj:EvidenceRequirement ;
    rdfs:label "Source evidence" ;
    dcterms:description "Exact canonical-source identity evidence." .
sj:local-execution-evidence a sj:EvidenceRequirement ;
    rdfs:label "Local execution evidence" ;
    dcterms:description "Observed repository-local exact-subject execution evidence." .
sj:hosted-ci-evidence a sj:EvidenceRequirement ;
    rdfs:label "Hosted CI evidence" ;
    dcterms:description "Hosted CI evidence kept distinct from local execution." .
sj:runtime-evidence a sj:EvidenceRequirement ;
    rdfs:label "Runtime evidence" ;
    dcterms:description "Runtime execution evidence for the exact admitted subject." .
sj:postcondition-evidence a sj:EvidenceRequirement ;
    rdfs:label "Postcondition evidence" ;
    dcterms:description "Independent evidence that the required consequence holds." .
sj:receipt-evidence a sj:EvidenceRequirement ;
    rdfs:label "Receipt evidence" ;
    dcterms:description "Durable receipt evidence for the exact subject and transition." .
sj:replay-evidence a sj:EvidenceRequirement ;
    rdfs:label "Replay evidence" ;
    dcterms:description "Fresh replay over pack, dependency, graph, consequence, toolchain, and environment identities." .

sj:projection-jira a sj:ProjectionSpec ;
    rdfs:label "Jira/Markdown ticket" ;
    dcterms:description "Deterministic jira/markdown ticket projection; authority is NONE." ;
    sj:projectionType "jira" ;
    sj:extension "md" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.11.21-hand" ;
    sj:authorityClaim "NONE" .
sj:projection-hddl a sj:ProjectionSpec ;
    rdfs:label "HDDL task/method projection" ;
    dcterms:description "Deterministic hddl task/method projection; authority is NONE." ;
    sj:projectionType "hddl" ;
    sj:extension "hddl" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.11.21-hand" ;
    sj:authorityClaim "NONE" .
sj:projection-ard a sj:ProjectionSpec ;
    rdfs:label "Architecture requirements document" ;
    dcterms:description "Deterministic architecture requirements document projection; authority is NONE." ;
    sj:projectionType "ard" ;
    sj:extension "md" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.11.21-hand" ;
    sj:authorityClaim "NONE" .

sj:objective-code-work-authority a sj:StrategicObjective ;
    rdfs:label "Code work originates from admitted semantic authority" ;
    dcterms:description "All code work originates from admitted semantic authority in the canonical graph; agents communicate only through sJira state; prose, chat, and Markdown are observation surfaces, never work authority." ;
    sj:admissionDigest "sha256:310e14f1e30a9bb4d6ebd4388036e10ce3c973b13c0d45a7b550fa3dfd53c72c" .


# ---- ZCODE-261121-01 (EXPLORE) ----
sj:zcode-261121-01
    a sj:WorkOrder ;
    rdfs:label "ZCODE-261121-01: Dogfood loop — pin GGEN_BIN and run sJira → POWL → ledger with honest exits" ;
    dcterms:identifier "ZCODE-261121-01" ;
    dcterms:title "Dogfood loop — pin GGEN_BIN and run sJira → POWL → ledger with honest exits" ;
    dcterms:description "[LANE:EXPLORE] Post-integrity-wave dogfood meta-order. Pin absolute GGEN_BIN (hands-free ancestor >= fd4f99bbd; no PATH fallback) and exercise the clean-room adapter seam: ggen sjira frontier (or SJIRA_CANDIDATES JSONL) → candidatesToPowl → runFoundryLoop / powl-foundry-loop --dry-run → ledger.jsonl + loop_receipt.json with honest exit codes 0/1/2/3 and no fake ALIVE. Marketplace + igniter courts must fail-closed (validateWriteScope before mutate; clean-room trio: unstaged + staged + untracked). Integrity PRs #21–#36+#38 are already on main at baseSha — do not re-open them. Standing stays UNKNOWN until a court receipt exists." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "2580032e6933d2c850918ccdf3d132d506a34726" ;
    sj:subject "zcode-cli:dogfood-loop-v26.11.21" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:originAuthority sj:objective-code-work-authority ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt binding candidateSha, subjectSha and a durable receipt for this subject; a passing test log alone, a generated ticket, or an upstream standing is not promotion. Explore and Exploit lanes must not cross-contaminate measurements." ;
    sj:replayIdentity "semantic-jira:v26.11.21:ZCODE-261121-01" ;
    sj:pathScope "src/adapters", "src/io", "scripts", "test", "docs/sjira/v26.11.21" ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:requiresCourt sj:court-zcode-261121-01 ;
    sj:requiresEvidence sj:source-evidence, sj:local-execution-evidence, sj:runtime-evidence, sj:receipt-evidence, sj:replay-evidence ;
    sj:acceptance sj:acc-zcode-261121-01-1, sj:acc-zcode-261121-01-2, sj:acc-zcode-261121-01-3 ;
    sj:falsifier sj:fal-zcode-261121-01-1, sj:fal-zcode-261121-01-2 ;
    sj:projection sj:projection-jira, sj:projection-hddl, sj:projection-ard ;
    sj:nextAction sj:run-court-zcode-261121-01 ;
    sj:nextCheckpoint sj:cp-zcode-261121-01 ;
    .

sj:court-zcode-261121-01 a sj:Court ;
    rdfs:label "ZCODE-261121-01 exact-subject court" ;
    dcterms:description "Independent court for Dogfood loop — pin GGEN_BIN and run sJira → POWL → ledger with honest exits: runs acceptance at an exact head and binds candidateSha, subjectSha, tool versions and receipt identity. Fail-closed; never fake ALIVE." .

sj:acc-zcode-261121-01-1 a sj:AcceptanceCriterion ;
    rdfs:label "GGEN_BIN absolute and pinned" ;
    dcterms:description "export GGEN_BIN to an absolute path whose --version / git identity is recorded; relative or PATH-resolved GGEN_BIN must refuse (GGEN_BIN_NOT_ABSOLUTE). Record tool identity in the receipt. Earns: GGEN_BIN_PINNED." .

sj:acc-zcode-261121-01-2 a sj:AcceptanceCriterion ;
    rdfs:label "Frontier → POWL ingest" ;
    dcterms:description "With SJIRA_CANDIDATES pointing at docs/sjira/v26.11.21 candidates (or \"$GGEN_BIN\" sjira frontier over this milestone graph), candidatesToPowl produces a PartialOrder and bun scripts/powl-foundry-loop.ts --dry-run exits with an honest code (0 success, 2 SUBJECT_MISSING/PARTIAL, never promotes PARTIAL_ALIVE→ALIVE). Earns: DOGFOOD_INGEST." .

sj:acc-zcode-261121-01-3 a sj:AcceptanceCriterion ;
    rdfs:label "Courts fail-closed" ;
    dcterms:description "bun test test/adapters.test.ts test/sjira-adapter.test.ts test/adapters-chicago.test.ts reports 0 fail at exact head; staged/untracked dirty trees refuse igniter clean-room; marketplace court does not short-circuit on ggen.toml. Earns: COURTS_FAIL_CLOSED." .

sj:fal-zcode-261121-01-1 a sj:Falsifier ;
    rdfs:label "PATH fallback" ;
    dcterms:description "Resolving ggen via PATH or a relative GGEN_BIN while claiming ALIVE refutes the pin." .

sj:fal-zcode-261121-01-2 a sj:Falsifier ;
    rdfs:label "Fake ALIVE" ;
    dcterms:description "loop_receipt.json standing ALIVE with nonzero aggregate exit or PARTIAL_ALIVE promotion without a new court refutes honesty." .

sj:cp-zcode-261121-01 a sj:Checkpoint ;
    rdfs:label "ZCODE-261121-01 checkpoint" ;
    dcterms:description "Closed when the ZCODE-261121-01 court returns a receipt at the exact head; the frontier then advances to dependents of this work order." .

sj:run-court-zcode-261121-01 a sj:Action ;
    rdfs:label "Next action for ZCODE-261121-01" ;
    dcterms:description "Run the acceptance commands of ZCODE-261121-01 at an exact head in the scoped worktree, preserve failure output as evidence, and never rerun an unchanged failure without a new hypothesis." .


