@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical RDF for ZOCEL work orders v26.9.22: open the 2026-09-22 cycle with three
# cross-repo OCEL orders (two on seanchatmangpt/xaas, one on seanchatmangpt/zcode-cli).
# Vocabulary is the semantic-jira-pack ontology; class and individual definitions below
# are the same sj: vocabulary as v26.9.21's canonical graph, declared once.
# This graph is hand-authored canonical source (法面 input), not a projection; the
# tickets under jira/ are hand-projections of it pending a semantic-jira-pack re-run.
# Edit this file, never a ticket.

sj:WorkOrder a rdfs:Class .
sj:Court a rdfs:Class .
sj:EvidenceRequirement a rdfs:Class .
sj:AcceptanceCriterion a rdfs:Class .
sj:Falsifier a rdfs:Class .
sj:Action a rdfs:Class .
sj:Checkpoint a rdfs:Class .
sj:ProjectionSpec a rdfs:Class .
sj:DependencyEdge a rdfs:Class .

sj:source-evidence a sj:EvidenceRequirement ;
    rdfs:label "Source evidence" ;
    dcterms:description "Exact canonical-source identity evidence." .
sj:local-execution-evidence a sj:EvidenceRequirement ;
    rdfs:label "Local execution evidence" ;
    dcterms:description "Observed repository-local exact-subject execution evidence." .
sj:hosted-ci-evidence a sj:EvidenceRequirement ;
    rdfs:label "Hosted CI evidence" ;
    dcterms:description "Hosted CI evidence kept distinct from local execution." .
sj:runtime-evidence a sj:EvidenceRequirement ;
    rdfs:label "Runtime evidence" ;
    dcterms:description "Runtime execution evidence for the exact admitted subject." .
sj:postcondition-evidence a sj:EvidenceRequirement ;
    rdfs:label "Postcondition evidence" ;
    dcterms:description "Independent evidence that the required consequence holds." .
sj:receipt-evidence a sj:EvidenceRequirement ;
    rdfs:label "Receipt evidence" ;
    dcterms:description "Durable receipt evidence for the exact subject and transition." .
sj:replay-evidence a sj:EvidenceRequirement ;
    rdfs:label "Replay evidence" ;
    dcterms:description "Fresh replay over pack, dependency, graph, consequence, toolchain, and environment identities." .

