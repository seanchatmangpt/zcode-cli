# ---- ZCODE-26108-01 ----
sj:zcode-26108-01
    a sj:WorkOrder ;
    rdfs:label "ZCODE-26108-01: Subagent max-turns resolution + expert-strategy config patch" ;
    dcterms:identifier "ZCODE-26108-01" ;
    dcterms:title "Subagent max-turns resolution + expert-strategy config patch" ;
    dcterms:description "Runtime lane of the v26.10.8 fleet campaign: subagent max-turns resolution plus the expert-strategy configuration patch, landed as commit daaec82ee293aead6160301895713f711518c8ef on fix/v26926-preview-publish-typed-skip. Receipt shape is the repo 5-field schema (identity/authority/consequence/replay/standing) per receipts/v26.9.22/_template.json; standing cites the campaign receipt docs/sjira/v26.10.8/CAMPAIGN-RECEIPT.md (suite 1081 passed / 0 failed at HEAD 00b7cbc9a700cd3bd5a73481cc62fa5e7583a2f5)." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "8926518000000000000000000000000000000000" ;
    sj:subjectSha "daaec82ee293aead6160301895713f711518c8ef" ;
    sj:subject "zcode-cli:fix/v26926-preview-publish-typed-skip@daaec82" ;
    sj:standing "ALIVE" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "DO" ;
    sj:authorityRequirement "Operator fleet-campaign order 2026-10-08 (v26.10.8 wave); no lane holds ambient execution authority beyond the landed diff itself." ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt binding candidateSha, subjectSha and a durable 5-field receipt for this subject." ;
    sj:replayIdentity "semantic-jira:v26.10.8:ZCODE-26108-01" ;
    sj:pathScope "src", "test", "docs/sjira/v26.10.8" ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:requiresCourt sj:court-zcode-26108-01 ;
    sj:requiresEvidence sj:source-evidence, sj:local-execution-evidence, sj:runtime-evidence, sj:postcondition-evidence, sj:receipt-evidence, sj:replay-evidence ;
    sj:acceptance sj:acc-zcode-26108-01-1, sj:acc-zcode-26108-01-2 ;
    sj:falsifier sj:fal-zcode-26108-01-1 ;
    sj:projection sj:projection-jira, sj:projection-receipt, sj:projection-replay ;
    sj:nextCheckpoint sj:cp-zcode-26108-01 .

sj:court-zcode-26108-01 a sj:Court ;
    rdfs:label "ZCODE-26108-01 exact-subject court" ;
    dcterms:description "Court for the subagent max-turns + expert-strategy lane: typecheck and unit tests at the exact landed head, verdict bound into a 5-field receipt." .

sj:acc-zcode-26108-01-1 a sj:AcceptanceCriterion ;
    rdfs:label "Typecheck + suite green at landed head" ;
    dcterms:description "cd /Users/sac/zcode-cli && bun run typecheck exits 0 and the unit suite reports 0 failed (witnessed 1081 passed / 0 failed at HEAD 00b7cbc in docs/sjira/v26.10.8/CAMPAIGN-RECEIPT.md). Earns: RUNTIME_LANE_GREEN." .
sj:acc-zcode-26108-01-2 a sj:AcceptanceCriterion ;
    rdfs:label "Commit present with claimed diff" ;
    dcterms:description "git log --format=%H -1 daaec82ee293aead6160301895713f711518c8ef resolves on fix/v26926-preview-publish-typed-skip and git show --stat names runtime/config files matching the expert-strategy patch. Earns: SUBJECT_IDENTITY_BOUND." .

sj:fal-zcode-26108-01-1 a sj:Falsifier ;
    rdfs:label "Green claim over red suite" ;
    dcterms:description "Observation: the suite exiting nonzero at the pinned head while any receipt claims the lane green refutes the standing (admission_vacuous)." .

sj:cp-zcode-26108-01 a sj:Checkpoint ;
    rdfs:label "ZCODE-26108-01 checkpoint" ;
    dcterms:description "Closed when the court receipt binds subjectSha daaec82 with green gates; the frontier advances to dependent docs lanes." .


# ---- ZCODE-26108-02 ----
sj:zcode-26108-02
    a sj:WorkOrder ;
    rdfs:label "ZCODE-26108-02: Migrate v26.9.22 receipts to 5-field schema (27/27)" ;
    dcterms:identifier "ZCODE-26108-02" ;
    dcterms:title "Migrate v26.9.22 receipts to 5-field schema" ;
    dcterms:description "Receipts lane: migrated all receipts/v26.9.22 receipts to the 5-field schema (identity/authority/consequence/replay/standing), with typed placeholders where fields were unrecoverable, landed as commit e416d731fd4877ac01269234bdc51faeebaf3af7. Court verdict: 27/27 receipts valid under the schema (fail-closed on zero files), witnessed in docs/sjira/v26.10.8/CAMPAIGN-RECEIPT.md." ;
    sj:repository "seanchatmangpt/zcode-cli" ;
    sj:baseSha "aa0d359000000000000000000000000000000000" ;
    sj:subjectSha "e416d731fd4877ac01269234bdc51faeebaf3af7" ;
    sj:subject "zcode-cli:receipts/v26.9.22@e416d73" ;
    sj:standing "ALIVE" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "DO" ;
    sj:authorityRequirement "Operator fleet-campaign order 2026-10-08 (v26.10.8 wave)." ;
    sj:promotionRule "Standing may advance only from an independent schema court receipt; a hand-asserted valid count is not promotion." ;
    sj:replayIdentity "semantic-jira:v26.10.8:ZCODE-26108-02" ;
    sj:pathScope "receipts/v26.9.22", "receipts/v26.9.23" ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:requiresCourt sj:court-zcode-26108-02 ;
    sj:requiresEvidence sj:source-evidence, sj:local-execution-evidence, sj:postcondition-evidence, sj:receipt-evidence, sj:replay-evidence ;
    sj:acceptance sj:acc-zcode-26108-02-1, sj:acc-zcode-26108-02-2 ;
    sj:falsifier sj:fal-zcode-26108-02-1 ;
    sj:projection sj:projection-jira, sj:projection-receipt ;
    sj:nextCheckpoint sj:cp-zcode-26108-02 .

sj:court-zcode-26108-02 a sj:Court ;
    rdfs:label "ZCODE-26108-02 receipts schema court" ;
    dcterms:description "Runs the repo receipts validator over receipts/v26.9.22 (and v26.9.23) and fails closed on any invalid or missing file; verdict 27/27 valid post-migration." .

sj:acc-zcode-26108-02-1 a sj:AcceptanceCriterion ;
    rdfs:label "27/27 receipts valid" ;
    dcterms:description "cd /Users/sac/zcode-cli && bun run receipts:validate exits 0 with every receipt valid under the 5-field schema (identity/authority/consequence/replay/standing, per receipts/v26.9.22/_template.json); fail-closed on zero files. Witnessed 27/27. Earns: RECEIPTS_SCHEMA_VALID." .
sj:acc-zcode-26108-02-2 a sj:AcceptanceCriterion ;
    rdfs:label "Typed placeholders disclosed" ;
    dcterms:description "Every unrecoverable migrated field carries an explicit typed placeholder (never a fabricated value), greppable in receipts/v26.9.22; any fabricated-looking literal without a placeholder marker refutes the migration. Earns: PLACEHOLDERS_TYPED." .

sj:fal-zcode-26108-02-1 a sj:Falsifier ;
    rdfs:label "Validator green over invalid receipt" ;
    dcterms:description "Observation: any receipt under receipts/v26.9.22 missing one of the five R-fields while the validator reports 27/27 valid refutes the court (admission_vacuous)." .

sj:cp-zcode-26108-02 a sj:Checkpoint ;
    rdfs:label "ZCODE-26108-02 checkpoint" ;
    dcterms:description "Closed when the schema court re-runs green at the current head; standing ALIVE persists only while the validator passes." .


